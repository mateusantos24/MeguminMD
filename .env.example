# Silenciar mensagens do dotenv
# Se você deseja silenciar as mensagens do dotenv, defina como true.
DOTENV_CONFIG_QUIET=true

# Database Path
# Caminho para o arquivo do banco de dados SQLite.
# O bot irá criar o arquivo no caminho especificado se ele não existir.
DB_PATH=./data/bot_database.sqlite

# Como obter a chave da API do Gemini:
# 1. Acesse https://aistudio.google.com e entra com sua conta Google.
# 2. Dentro do Google AI Studio, clica no botão “Get API key” / “Obter chave de API”.
# 3. Cria uma nova API key (ele vai pedir para selecionar/criar um projeto associado).
GEMINI_API_KEY=KEYS

# Como obter a chave da API do Tenor:
# 1. Hoje o Tenor é gerenciado pelo Google Cloud.
# 2. Vai no Google Cloud Console: https://console.cloud.google.com/ e faz login.
# 3. Cria ou seleciona um projeto no topo da página.
# 4. No search, procura por “Tenor API”, entra na página da Tenor API e clica em “ENABLE”.
# 5. Depois vai em “APIs & Services” → “Credentials” → “+ CREATE CREDENTIALS” → “API key”.
TENOR_API_KEY=KEYS

# Como obter a chave da API do TMDB (The Movie Database):
# 1. Acesse https://www.themoviedb.org/signup e cria uma conta grátis (ou faz login se já tiver).
# 2. Depois de logado, vai em: https://www.themoviedb.org/settings/api (ou clica no avatar → Settings → API).
# 3. Preenche o formulário de "Developer API key" (nome do app, URL, etc.) e envia.
TMDB_API_KEY=KEYS

# Groq API Key
# Usada pelos comandos e respostas de IA compatíveis com Groq.
GROQ_API_KEY=KEYS
GROQ_TOKEN=KEYS

# Eventos e notificações dos grupos com filtro: @g.us, @s.whatsapp.net ou @lid. 
# 1. Também envia newsletter ou qualquer outra informação, se necessário
EVENTOLOGS=123456789@g.us

# Canal específico para avisos do Banco do Norte.
# Se deixar vazio, o banco usa o EVENTOLOGS como fallback.
BANK_EVENTOLOGS=123456789@g.us

# Timezone global do bot (padrao recomendado)
BOT_TIMEZONE=America/Sao_Paulo

# Anti-Deleted System 
# Se você deseja ativar o sistema de anti-delete, defina como true.
# Isso irá monitorar as mensagens deletadas e reenviá-las para o grupo.
ANTIDELETE_DEBUG=false

# AssemblyAI API Key
# Para obter a chave da API do AssemblyAI, siga os passos abaixo:
# 1. Acesse https://www.assemblyai.com/ e faça login ou crie uma conta.
# 2. Vá até a seção de "API Keys" (ou algo similar) e copie a chave fornecida.
ASSEMBLYAI_API_KEY=KEYS

# Backup OU Github Backup
# Se você deseja, escolha o filtro de backup: local, github, off, auto (padrão)
# - local: Faz backup do banco de dados local a cada 24 horas
# - github: Faz backup no GitHub a cada 24 horas (requer GITHUB_BACKUP_REMOTE configurado)
# - off: Desabilita completamente o backup (pode usar off, disable, disabled ou false)
# - auto: Escolhe automaticamente entre local ou github (padrão se deixar vazio)
# O bot pode funcionar com repositórios GitHub públicos ou privados.
BACKUP_FILTER=local

# Backup Automático
# Se você deseja ativar o backup automático no GitHub, defina como true.
# Isso irá fazer o bot fazer um backup do banco de dados local no GitHub a cada 24 horas.
# O backup será feito no branch "main" do repositório especificado.
# É necessário fornecer o token de acesso pessoal (PAT) do GitHub com permissões de escrita no repositório.
# O formato do token deve ser: x-access-token:seu_token_aqui
# Isso é necessário para autenticação no GitHub e permitir o push do backup.
# O repositório remoto deve ser fornecido no formato: https://x-access-token:seu_token_aqui@github.com/usuario/repositorio.git
# Substitua "usuario" e "repositorio" pelos seus valores.
GITHUB_NOTIFIER=123456789@g.us
GITHUB_AUTHORNAME=usuario
GITHUB_AUTHOREMAIL=usuario@users.noreply.github.com
GITHUB_DELAYHOURS=24
GITHUB_RETRYMINUTES=10
GITHUB_BACKUP_REMOTE=https://x-access-token:KEYS@github.com/usuario/repositorio.git

# Mercado Pago Access Token
# Para obter o token de acesso do Mercado Pago, siga os passos abaixo:
# 1. Acesse https://www.mercadopago.com.br/ e faça login ou crie uma conta.
# 2. Vá até a seção de "Configurações" (ou algo similar) e copie o token de acesso fornecido.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_TOKEN...............

# Debug mode para o LidPN
LID_PN_DEBUG=1

// Modo de manutenção
MAINTENANCE_MODE=false

# Reinício Automático
# Opções: on (ativar) ou off (desativar)
# Quando ativado, o bot se reinicia automaticamente diariamente
# Horários: 01:50 (aviso), 02:00 (restart), 02:01 (retorno)
RESTART_SCHEDULE=off

# Google APIs Key (Maps e Tenor)
# Para obter uma chave de API do Google:
# 1. Acesse https://console.cloud.google.com/
# 2. Crie um novo projeto ou selecione um existente
# 3. Ative as APIs: Maps API, Tenor API
# 4. Vá em Credenciais e crie uma API Key
GOOGLE_API_KEY=AIzaSy...

# WeatherAPI
# Crie sua chave em https://www.weatherapi.com/ e use no comando /clima
WEATHERAPI_KEY=KEYS

# Roblox Cookies authentication
# Para obter os cookies de autenticação do Roblox, siga os passos abaixo:
# 1. Acesse https://www.roblox.com/ e faça login na sua conta.
# 2. Abra as ferramentas de desenvolvedor do seu navegador (geralmente pressionando F12 ou clicando com o botão direito e selecionando "Inspecionar").
# 3. Vá para a aba "Application" (ou "Armazenamento") e depois para "Cookies".
# 4. Encontre os cookies "ROBLOSECURITY" e "X-CSRF-TOKEN" e copie seus valores.
ROBLOX_SECURITY_COOKIE
X-CSRF-TOKEN=

# Discord
# Para obter o token do bot do Discord, siga os passos abaixo:
# 1. Acesse https://discord.com/developers/applications e faça login com sua conta do Discord.
# 2. Clique em "New Application" e dê um nome para sua aplicação.
# 3. No menu lateral, vá para "Bot" e clique em "Add Bot".
# 4. Depois de criar o bot, clique em "Copy" para copiar o token do bot e cole no campo DISCORD_BOT_TOKEN abaixo.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REGISTRATION_CHANNEL_ID=
DISCORD_REGISTRATION_ROLE_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_CHANNEL_SERVER_STATUS=
DISCORD_CHANNEL_YOUTUBE_NOTIFICATIONS=
DISCORD_CHANNEL_WHATSAPP_CHAT=
DISCORD_CHANNEL_COMMAND_LOGS=
DISCORD_CHANNEL_MEDIA_LOGS=
DISCORD_CHANNEL_BAD_WORDS_LOGS=
DISCORD_CHANNEL_ANTI_DELETED_LOGS=
DISCORD_CHANNEL_AKA_LOGS=
DISCORD_CHANNEL_ACTIONS_LOGS=
DISCORD_CHANNEL_SESSION_ALERTS=
DISCORD_BRIDGE_CHANNEL_ID=
DISCORD_BRIDGE_COMMAND_LOGS_CHANNEL_ID=
DISCORD_BRIDGE_MEDIA_LOGS_CHANNEL_ID=
DISCORD_MUSIC_VOICE_CATEGORY_ID=
DISCORD_TICKET_CHANNEL_ID=
DISCORD_TICKET_MESSAGE_ID=
DISCORD_TICKET_CATEGORY_ID=

# Telegram
# Destinos aceitam topicos no formato chat_id_topic_id.
# Exemplo: -1003859381210_5
# Para enviar para mais de um topico, separe por virgula.
# Exemplo: -1003859381210_3,-1003830929696_6
# Liga ou desliga Telegram na Megumin
TELEGRAM_ENABLED=false

# Token do bot criado no BotFather
# IMPORTANTE: você expôs esse token no chat. Recomendo usar /revoke no BotFather e gerar outro.
TELEGRAM_BOT_TOKEN=

# Status online/offline do WhatsApp
# Pode mandar para um tópico "Status", exemplo: -1003859381210_7
TELEGRAM_CHANNEL_SERVER_STATUS=

# Notificação de YouTube
# Seu print mostrou: https://t.me/c/3859381210/5
TELEGRAM_CHANNEL_YOUTUBE_NOTIFICATIONS=

# Mensagens normais do WhatsApp monitorado
# Se deixar vazio, NÃO manda chat normal para Telegram.
TELEGRAM_CHANNEL_WHATSAPP_CHAT=

# Logs de comandos do WhatsApp
# Você falou que comandos é tópico 3.
TELEGRAM_CHANNEL_COMMAND_LOGS=

# Logs de mídias recebidas
TELEGRAM_CHANNEL_MEDIA_LOGS=

# Logs de anti-palavrão
TELEGRAM_CHANNEL_BAD_WORDS_LOGS=

# Logs de anti-delete
TELEGRAM_CHANNEL_ANTI_DELETED_LOGS=

# Logs de mudança AKA/nome
TELEGRAM_CHANNEL_AKA_LOGS=

# Logs de ações, tipo anti-link
TELEGRAM_CHANNEL_ACTIONS_LOGS=

# Alertas de sessão
TELEGRAM_CHANNEL_SESSION_ALERTS=

# Liga o bridge WhatsApp -> Telegram
TELEGRAM_BRIDGE_ENABLED=true

# Chat normal do WhatsApp vai para cá.
# Deixe vazio se você NÃO quer conversa normal fora de tópico.
TELEGRAM_BRIDGE_CHAT_ID=

# Se quiser monitorar só alguns grupos WhatsApp, coloque os IDs separados por vírgula.
# Vazio = aceita todos que o bridge do bot processar.
TELEGRAM_BRIDGE_ALLOWED_CHAT_IDS=

# Ignora mensagens enviadas pelo próprio bot WhatsApp
TELEGRAM_BRIDGE_IGNORE_FROM_ME=true

# Se receber imagem/video/audio, mostra aviso tipo "[imagem recebida no WhatsApp]"
TELEGRAM_BRIDGE_INCLUDE_MEDIA_NOTICE=true

# Força comandos para o tópico de comandos
TELEGRAM_BRIDGE_COMMAND_LOGS_CHAT_ID=

# Força mídias para tópico de mídias
TELEGRAM_BRIDGE_MEDIA_LOGS_CHAT_ID=

# Privacidade dos comandos
# hide = esconde conteúdo quando for dono
TELEGRAM_BRIDGE_COMMAND_LOG_PRIVACY=hide

# Privacidade das mensagens normais
TELEGRAM_BRIDGE_MESSAGE_LOG_PRIVACY=hide

# Privacidade de logs sensíveis: mídia, anti-delete, anti-palavrão
TELEGRAM_BRIDGE_AUDIT_LOG_PRIVACY=hide

{
  "name": "megumin-bot",
  "version": "5.2.0",
  "description": "Bot de WhatsApp com Baileys, comandos modulares, SQLite, VIP, sistema de casas, runtime config, monitores Discord/Telegram, schedulers, auto-restart configuravel e integracoes externas",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:bun": "bun index.js",
    "dev": "node --watch index.js",
    "dev:bun": "bun --watch index.js lib backup",
    "test:casamento-card": "node debug/renderCasamentoProfileTest.js",
    "test:casamento-event": "node debug/renderCasamentoEventTest.js",
    "postinstall": "patch-package && node lib/utils/pathbaileys.js",
    "patch:baileys": "node lib/utils/pathbaileys.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@itsliaaa/baileys": "^0.3.3",
    "audio-decode": "2.2.3",
    "axios": "^1.12.2",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "discord.js": "^14.26.3",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.1.1",
    "is-antibot": "^1.1.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.6.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.2.1",
    "pino": "^8.19.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "twemoji": "^14.0.2"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "sharp": "^0.32.1"
  },
  "author": "Rei Ayanami",
  "license": "MIT",
  "trustedDependencies": [],
  "overrides": {
    "audio-decode": "2.2.3",
    "jimp": "1.6.1"
  }
}
